## Google OAuth 2.0: never put credentials in the repository.
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/admin/google-oauth-callback.php
# Optional only for multi-server deployments: Base64 of exactly 32 random bytes.
APP_ENCRYPTION_KEY=
# Database credentials are supplied by the hosting environment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=centro_medico
DB_USER=root
DB_PASSWORD=
# Canonical public URL used in account recovery links (HTTPS in production).
APP_URL=http://127.0.0.1:8000
